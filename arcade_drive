def calculate_arcade_drive(x: float, y: float) -> tuple[float, float]:
    """Converts Arcade Drive Joystick inputs (X, Y) to Left and Right motor powers.

    Parameters:
        x (float): Steering input (-1.0 = Full Left, +1.0 = Full Right)
        y (float): Throttle input (-1.0 = Full Reverse, +1.0 = Full Forward)

    Returns:
        tuple[float, float]: (left_power, right_power) clamped between -1.0 and +1.0
    """
    # Step 1: Basic Arcade Drive Formula
    left_power = y + x
    right_power = y - x

    # Step 2: Normalization / Scaling
    # If a value exceeds 1.0 (e.g., full forward y=1.0 + full right x=1.0 = 2.0),
    # scale both motors down proportionally to preserve the turning ratio.
    max_magnitude = max(abs(left_power), abs(right_power))

    if max_magnitude > 1.0:
        left_power /= max_magnitude
        right_power /= max_magnitude

    return round(left_power, 3), round(right_power, 3)


